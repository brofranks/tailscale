From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brody Franks <brody@franks.id.au>
Date: Sun, 22 Nov 2026 10:32:36 -0800
Subject: [PATCH] net/dns: keep a split route with a proxied upstream in the
 forwarder

A split route whose domains all share one resolver set is handed to the
OS directly. That dropped DoH and custom-port upstreams from the set and
published a DoH-only server as a plain nameserver. Keep the whole route
in the local forwarder unless the OS can use every upstream at port 53.

Allow the OS to use Control D's legacy IPv6 resolvers directly. Only
the specific Control D bootstrap addresses retain their existing
DoH-only classification.

Change-Id: Ida4f5fed39260af74b3f1745096313ef02598e46
Signed-off-by: Brody Franks <brody@franks.id.au>
---
 net/dns/manager.go             | 13 ++++++----
 net/dns/manager_test.go        | 54 ++++++++++++++++++++++++++++++++++++++++
 net/dns/publicdns/publicdns.go | 15 +++++------
 3 files changed, 68 insertions(+), 14 deletions(-)

diff --git a/net/dns/manager.go b/net/dns/manager.go
index 8defe8f47bf9141461537ff71c89cf61e0f074cb..ef049ada945b8de91d85a1e1a422d568a1868aa4 100644
--- a/net/dns/manager.go
+++ b/net/dns/manager.go
@@ -23,6 +23,7 @@
 	"tailscale.com/envknob"
 	"tailscale.com/feature/buildfeatures"
 	"tailscale.com/health"
+	"tailscale.com/net/dns/publicdns"
 	"tailscale.com/net/dns/resolver"
 	"tailscale.com/net/netmon"
 	"tailscale.com/net/tsdial"
@@ -631,14 +632,16 @@ func (m *Manager) reapplyConfig() error {
 
 var isSandboxedMacOS = version.IsSandboxedMacOS
 
-// toIPsOnly returns only the IP portion of dnstype.Resolver.
-// Only safe to use if the resolvers slice has been cleared of
-// DoH or custom-port entries with something like hasDefaultIPResolversOnly.
+// toIPsOnly returns the IP portion of resolvers. It returns nil if any of
+// them needs the local forwarder: a DoH URL, a custom port or a DoH-only
+// server.
 func toIPsOnly(resolvers []*dnstype.Resolver) (ret []netip.Addr) {
 	for _, r := range resolvers {
-		if ipp, ok := r.IPPort(); ok && ipp.Port() == 53 {
-			ret = append(ret, ipp.Addr())
+		ipp, ok := r.IPPort()
+		if !ok || ipp.Port() != 53 || publicdns.IPIsDoHOnlyServer(ipp.Addr()) {
+			return nil
 		}
+		ret = append(ret, ipp.Addr())
 	}
 	return ret
 }
