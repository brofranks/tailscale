@@ -1440,6 +1451,49 @@ func baseConfigRetryTotal() time.Duration {
 	return total
 }
 
+// The OS can represent a split route directly only when it can use every
+// upstream at port 53. Otherwise the local resolver keeps the complete route.
+func TestSplitDNSRequiresProxy(t *testing.T) {
+	const suffix = "corp.example."
+	for _, tc := range []struct {
+		name            string
+		upstreams, want []*dnstype.Resolver
+	}{
+		{
+			"doh-only",
+			mustRes("2a07:a8c0::1234"),
+			mustRes("https://dns.nextdns.io/1234"),
+		},
+		{
+			"mixed-doh",
+			mustRes("192.0.2.53", "https://dns.example/dns-query"),
+			mustRes("192.0.2.53", "https://dns.example/dns-query"),
+		},
+		{
+			"mixed-ports",
+			mustRes("192.0.2.53", "192.0.2.54:5353"),
+			mustRes("192.0.2.53", "192.0.2.54:5353"),
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m, f, _ := newEmptyBaseConfigManager(t)
+			f.SplitDNS = true
+			cfg := Config{Routes: map[dnsname.FQDN][]*dnstype.Resolver{suffix: tc.upstreams}}
+			if err := m.Set(cfg); err != nil {
+				t.Fatal(err)
+			}
+			if !slices.Equal(f.OSConfig.Nameservers, serviceAddr46) ||
+				!slices.Equal(f.OSConfig.MatchDomains, []dnsname.FQDN{suffix}) {
+				t.Fatalf("OS nameservers %v, domains %v", f.OSConfig.Nameservers, f.OSConfig.MatchDomains)
+			}
+			got := m.Resolver().GetUpstreamResolvers("node.corp.example.")
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Fatalf("forwarders (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
 // splitDNSOnlyConfig returns a config with a route and MagicDNS but no
 // DefaultResolvers, so the "." route can only come from the OS base config.
 func splitDNSOnlyConfig() Config {
diff --git a/net/dns/publicdns/publicdns.go b/net/dns/publicdns/publicdns.go
index fe4d1caa6a07547c9f0038a1f598a6ae03068fcc..15f0af20b1c3e62d3b77ce8e0059815143e691d6 100644
--- a/net/dns/publicdns/publicdns.go
+++ b/net/dns/publicdns/publicdns.go
@@ -320,14 +320,11 @@ func populate() {
 	wikimediaDNSv4Addr = netip.MustParseAddr(wikimediaDNSv4)
 	wikimediaDNSv6Addr = netip.MustParseAddr(wikimediaDNSv6)
 
-	// The Control D IPv6 ranges (primary and secondary). The customer ID is
-	// encoded in the ipv6 address is used (in base 36 form) as the DoH query
-	controlDv6RangeA = netip.MustParsePrefix("2606:1a40::/48")
-	controlDv6RangeB = netip.MustParsePrefix("2606:1a40:1::/48")
-	controlDv4One    = netip.MustParseAddr("76.76.2.22")
-	controlDv4Two    = netip.MustParseAddr("76.76.10.22")
-	controlDv6One    = netip.MustParseAddr("2606:1a40::22")
-	controlDv6Two    = netip.MustParseAddr("2606:1a40:1::22")
+	// Bootstrap addresses for Control D's premium DoH endpoint.
+	controlDv4One = netip.MustParseAddr("76.76.2.22")
+	controlDv4Two = netip.MustParseAddr("76.76.10.22")
+	controlDv6One = netip.MustParseAddr("2606:1a40::22")
+	controlDv6Two = netip.MustParseAddr("2606:1a40:1::22")
 )
 
 // nextDNSv6Gen generates a NextDNS IPv6 address from the upper 8 bytes in the
@@ -347,7 +344,7 @@ func IPIsDoHOnlyServer(ip netip.Addr) bool {
 	return nextDNSv6RangeA.Contains(ip) || nextDNSv6RangeB.Contains(ip) ||
 		nextDNSv4RangeA.Contains(ip) || nextDNSv4RangeB.Contains(ip) ||
 		ip == wikimediaDNSv4Addr || ip == wikimediaDNSv6Addr ||
-		controlDv6RangeA.Contains(ip) || controlDv6RangeB.Contains(ip) ||
+		ip == controlDv6One || ip == controlDv6Two ||
 		ip == controlDv4One || ip == controlDv4Two
 }
 
