From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brody Franks <brody@franks.id.au>
Date: Thu, 19 Nov 2026 17:23:11 -0800
Subject: [PATCH] net/netmon: identify Linux tunnel address events by interface

An add-only CGNAT address change on a physical LAN can leave the
interface snapshot stale. Suppress notifications only for the known
tunnel index so underlay additions and deletions reach the monitor.

Change-Id: I8aed8269575a49ee47698d59eabbea0d281bf3a0
Signed-off-by: Brody Franks <brody@franks.id.au>
---
 net/netmon/netmon_linux.go      |  3 ++-
 net/netmon/netmon_linux_test.go | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/net/netmon/netmon_linux.go b/net/netmon/netmon_linux.go
index b7d87f995634fa1a42595e5fc811edf913c98174..28d8850e896c0dad1743291cbb03b711c57e1c3d 100644
--- a/net/netmon/netmon_linux.go
+++ b/net/netmon/netmon_linux.go
@@ -303,7 +303,8 @@ type newAddrMessage struct {
 }
 
 func (m *newAddrMessage) ignore() bool {
-	return tsaddr.IsTailscaleIP(m.Addr)
+	index := tsIfProps.tsIfIndex()
+	return index > 0 && uint32(index) == m.IfIndex
 }
 
 type ignoreMessage struct{}
diff --git a/net/netmon/netmon_linux_test.go b/net/netmon/netmon_linux_test.go
index c4e59059ac4c43efe5c55e629f30f01819581d20..d6a2b9a7b034de96949695c712e1a33fb95ea375 100644
--- a/net/netmon/netmon_linux_test.go
+++ b/net/netmon/netmon_linux_test.go
@@ -99,3 +99,37 @@ func TestIgnoreDuplicateNEWADDR(t *testing.T) {
 		}
 	})
 }
+
+func TestTunnelAddressEvents(t *testing.T) {
+	oldName, oldIndex := tsIfProps.tsIfName(), tsIfProps.tsIfIndex()
+	t.Cleanup(func() { tsIfProps.set(oldName, oldIndex) })
+
+	for _, tc := range []struct {
+		registered int
+		ifIndex    uint32
+		wantIgnore bool
+	}{
+		{0, 7, false},
+		{7, 7, true},
+		{7, 8, false},
+	} {
+		tsIfProps.set("wg0", tc.registered)
+		c := nlConn{
+			logf:      t.Logf,
+			addrCache: make(map[uint32]map[netip.Addr]bool),
+		}
+		for _, addr := range []string{"100.70.1.4", "10.22.3.5", "fd7a:115c:a1e0::9"} {
+			for _, typ := range []netlink.HeaderType{unix.RTM_NEWADDR, unix.RTM_DELADDR} {
+				c.buffered = []netlink.Message{newAddrMsg(tc.ifIndex, addr, typ)}
+				msg, err := c.Receive()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got := msg.ignore(); got != tc.wantIgnore {
+					t.Errorf("registered=%d ifIndex=%d type=%d addr=%s: ignore=%v, want %v",
+						tc.registered, tc.ifIndex, typ, addr, got, tc.wantIgnore)
+				}
+			}
+		}
+	}
+}
