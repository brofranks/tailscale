From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brody Franks <brody@franks.id.au>
Date: Thu, 22 Oct 2026 23:14:19 -0700
Subject: [PATCH] net/netmon: skip the registered Tailscale interface in
 LocalAddresses

LocalAddresses recognizes the Tailscale interface only by its
addresses, so a tunnel registered with SetTailscaleInterfaceProps
whose addresses lie outside Tailscale's ranges is advertised as a
local endpoint.

Change-Id: I5730d06bddf75bf49900cad05975f14e2d674895
Signed-off-by: Brody Franks <brody@franks.id.au>
---
 net/netmon/interfaces_test.go | 28 ++++++++++++++++++++++++++++
 net/netmon/state.go           | 11 +++++++----
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/net/netmon/interfaces_test.go b/net/netmon/interfaces_test.go
index bd81eb96a42bfb0e6ef6eec4cfb5906b45f53858..34ddfe260d7188ae63f51f4e23953b5df2168f25 100644
--- a/net/netmon/interfaces_test.go
+++ b/net/netmon/interfaces_test.go
@@ -7,6 +7,7 @@
 	"encoding/json"
 	"net"
 	"net/netip"
+	"slices"
 	"testing"
 
 	"tailscale.com/tstest"
@@ -125,6 +126,33 @@ func TestLikelyHomeRouterIP(t *testing.T) {
 	})
 }
 
+func TestLocalAddressesSkipsTailscaleInterface(t *testing.T) {
+	up := net.FlagUp | net.FlagBroadcast | net.FlagMulticast | net.FlagRunning
+	tstest.Replace(t, &altNetInterfaces, func() ([]Interface, error) {
+		return []Interface{
+			{
+				Interface: &net.Interface{Index: 1, MTU: 1500, Name: "eth0", Flags: up},
+				AltAddrs:  []net.Addr{&net.IPNet{IP: net.ParseIP("192.0.2.10"), Mask: net.CIDRMask(24, 32)}},
+			},
+			{
+				// The tunnel holds an address outside Tailscale's ranges.
+				Interface: &net.Interface{Index: 2, MTU: 1280, Name: "wg0", Flags: up},
+				AltAddrs:  []net.Addr{&net.IPNet{IP: net.ParseIP("198.51.100.1"), Mask: net.CIDRMask(24, 32)}},
+			},
+		}, nil
+	})
+	SetTailscaleInterfaceProps("wg0", 2)
+	t.Cleanup(func() { tsIfProps.set("", 0) })
+
+	regular, _, err := LocalAddresses()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []netip.Addr{netip.MustParseAddr("192.0.2.10")}; !slices.Equal(regular, want) {
+		t.Errorf("LocalAddresses = %v, want %v", regular, want)
+	}
+}
+
 // https://github.com/tailscale/tailscale/issues/10466
 func TestLikelyHomeRouterIP_Prefix(t *testing.T) {
 	ipnet := func(s string) net.Addr {
diff --git a/net/netmon/state.go b/net/netmon/state.go
index c5e356c72c0269e1cd73f45b0373c50c1831b053..6463f41d89328aa4c8fd98ec99eee290688391dd 100644
--- a/net/netmon/state.go
+++ b/net/netmon/state.go
@@ -62,13 +62,16 @@ func LocalAddresses() (regular, loopback []netip.Addr, err error) {
 	if err != nil {
 		return nil, nil, err
 	}
+	// The Tailscale interface's addresses are routed over Tailscale itself,
+	// whatever range they come from, so they are never local endpoints.
+	tsIfName, _ := TailscaleInterfaceName()
 	var regular4, regular6, linklocal4, ula6 []netip.Addr
 	for _, iface := range ifaces {
 		stdIf := iface.Interface
-		if !isUp(stdIf) || isProblematicInterface(stdIf) {
-			// Skip down interfaces and ones that are
-			// problematic that we don't want to try to
-			// send Tailscale traffic over.
+		if !isUp(stdIf) || isProblematicInterface(stdIf) || stdIf.Name == tsIfName {
+			// Skip down interfaces, the Tailscale interface, and
+			// ones that are problematic that we don't want to try
+			// to send Tailscale traffic over.
 			continue
 		}
 		ifcIsLoopback := isLoopback(stdIf)
